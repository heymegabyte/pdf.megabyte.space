# ─────────────────────────────────────────────────────────────────────────────
# Megabyte PDF — example secrets file
# ─────────────────────────────────────────────────────────────────────────────
#
# Local dev:   copy to `.dev.vars` (Wrangler reads it automatically).
# Production:  set each value via `wrangler secret put <NAME>`.
#
# Non-secret vars (APP_URL, APP_NAME, FREE_PROJECT_LIMIT, etc.) live in
# `wrangler.toml` under [vars] / [env.production.vars]. Bindings (DB, PDFS,
# CACHE, BROWSER, AI, ASSETS) are wired via wrangler.toml too — not here.
#
# Anything marked REQUIRED must be set before the worker will boot cleanly.
# Anything marked OPTIONAL degrades gracefully when missing.
# ─────────────────────────────────────────────────────────────────────────────


# ── Anthropic ──────────────────────────────────────────────────────────────
# REQUIRED — used by /api/chat (Sonnet) and AI title/metadata fallback (Haiku).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...


# ── Google OAuth (sign-in) ─────────────────────────────────────────────────
# REQUIRED for /api/auth/google. Create OAuth 2.0 credentials at
# https://console.cloud.google.com/apis/credentials
# Redirect URI: https://pdf.megabyte.space/api/auth/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...


# ── Session signing ────────────────────────────────────────────────────────
# REQUIRED — HMAC-SHA-256 key for the `__session` cookie. Use 32+ random bytes.
# Generate: `openssl rand -hex 32`
SESSION_SECRET=replace-with-32-bytes-of-hex


# ── Stripe (billing) ───────────────────────────────────────────────────────
# OPTIONAL — billing endpoints return 503 when missing. Required for paid tier.
# Keys: https://dashboard.stripe.com/apikeys
# Webhook secret: created when you add the endpoint in the Stripe dashboard.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_UNLIMITED=price_...


# ── Sentry (error tracking) ────────────────────────────────────────────────
# OPTIONAL — when unset, `app.onError` still logs but no remote capture.
# DSN: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_DSN_CLIENT=https://...@o0.ingest.sentry.io/0


# ── PostHog (product analytics) ────────────────────────────────────────────
# OPTIONAL — frontend reads VITE_POSTHOG_* at build time; these are server-side.
# Get keys at https://us.posthog.com/project/settings
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.posthog.com


# ── GTM / GA4 ──────────────────────────────────────────────────────────────
# OPTIONAL — frontend tags. Containers at https://tagmanager.google.com
GTM_CONTAINER_ID=GTM-XXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX


# ── Trending feed tuning ───────────────────────────────────────────────────
# OPTIONAL — defaults: 7 days half-life, 250 candidates. Higher = older content
# decays slower / more sources sampled before ranking.
TRENDING_HALFLIFE_DAYS=7
TRENDING_CANDIDATE_POOL=250


# ── Listmonk (transactional + cohort email) ────────────────────────────────
# REQUIRED for email flows. When fully unset, every public endpoint that
# would send mail still returns 200 with `queued:true` and logs a Sentry
# warning — signups are never lost. See src/worker/lib/listmonk.ts.
# Auth header is `token <user>:<key>` (Listmonk 3.x API-user pattern).
LISTMONK_BASE_URL=https://listmonk.megabyte.space
LISTMONK_API_USER=automation
LISTMONK_API_TOKEN=...
LISTMONK_FROM_EMAIL=hello@megabyte.space
LISTMONK_FROM_NAME=Megabyte PDF
LISTMONK_LIST_ID=1
LISTMONK_PODCAST_LIST_ID=2
LISTMONK_NEWSLETTER_LIST_ID=3


# ── Email unsubscribe signing ──────────────────────────────────────────────
# REQUIRED if any email is sent. HMAC-SHA-256 key for unsubscribe link tokens.
# Generate: `openssl rand -hex 32`
EMAIL_UNSUB_SECRET=replace-with-32-bytes-of-hex


# ── Admin notifications ────────────────────────────────────────────────────
# OPTIONAL — destination for ops alerts (signups, errors surfaced via cron).
ADMIN_EMAIL=hey@megabyte.space


# ── Cron auth ──────────────────────────────────────────────────────────────
# OPTIONAL — when set, the manual cron-trigger endpoint requires this bearer.
# Generate: `openssl rand -hex 24`
CRON_SECRET=replace-with-24-bytes-of-hex
